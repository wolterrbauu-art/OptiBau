<title>OptiBau — Optimización de juegos para tu PC</title>
<style>
:root{--bg:#070b14;--panel:#0c1423;--panel2:#101d31;--line:#20334d;--blue:#19a7ff;--blue2:#536dff;--text:#edf5ff;--muted:#9aabc2;--good:#50e3ff;--shadow:0 18px 55px #0007}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(ellipse at 75% -15%,#122c52 0,transparent 42%),var(--bg);color:var(--text);font:15px/1.55 system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif}button,input,select{font:inherit}button{cursor:pointer}a{color:inherit;text-decoration:none}.wrap{max-width:1440px;margin:auto;padding:0 24px}
header{position:sticky;top:0;z-index:10;background:#070b14eF;backdrop-filter:blur(16px);border-bottom:1px solid #1c2a40}.nav{height:72px;display:flex;align-items:center;gap:30px}.brand{font-size:26px;font-weight:900;letter-spacing:-1px;display:flex;align-items:center;gap:10px;white-space:nowrap}.logo{display:grid;place-items:center;width:38px;height:38px;border-radius:12px;background:linear-gradient(135deg,var(--blue),var(--blue2));box-shadow:0 0 25px #19a7ff55;font-size:22px}.brand span:last-child{background:linear-gradient(90deg,#fff,#60caff);color:transparent;background-clip:text}.navlinks{display:flex;gap:7px;align-items:center;flex:1}.navlinks a{padding:10px 13px;border-radius:10px;color:var(--muted)}.navlinks a:hover,.navlinks a.active{color:white;background:#13243a}.navright{font-size:12px;color:var(--muted)}.hero{display:grid;grid-template-columns:1.2fr .8fr;align-items:center;gap:32px;padding:58px 0 38px}.eyebrow{color:var(--good);font-weight:800;text-transform:uppercase;letter-spacing:2px;font-size:11px}.hero h1{font-size:clamp(34px,4.5vw,60px);line-height:1.04;letter-spacing:-2px;margin:13px 0 17px;max-width:760px}.gradient{background:linear-gradient(90deg,#fff,#3cbaff 52%,#7785ff);color:transparent;background-clip:text}.hero p{color:var(--muted);font-size:17px;max-width:670px;margin:0 0 24px}.actions{display:flex;gap:12px;flex-wrap:wrap}.btn{border:1px solid transparent;border-radius:12px;padding:12px 17px;font-weight:800;display:inline-flex;align-items:center;justify-content:center;gap:8px;transition:.2s}.btn.primary{background:linear-gradient(100deg,var(--blue),var(--blue2));color:#fff;box-shadow:0 8px 28px #287dff30}.btn.primary:hover{transform:translateY(-2px);filter:brightness(1.1)}.btn.secondary{background:#101b2b;border-color:var(--line);color:var(--text)}.hero-art{min-height:260px;position:relative;display:grid;place-items:center;overflow:hidden;border:1px solid #1b3655;border-radius:26px;background:radial-gradient(circle at 50% 45%,#174e87 0,#10223a 38%,#0a111e 72%);box-shadow:var(--shadow)}.orbit{position:absolute;width:260px;height:260px;border:1px solid #49baff55;border-radius:50%;box-shadow:0 0 45px #19a7ff18}.orbit:before,.orbit:after{content:"";position:absolute;border:1px solid #49baff30;border-radius:50%;inset:25px}.orbit:after{inset:55px}.chip{position:relative;z-index:1;width:132px;height:132px;display:grid;place-items:center;border-radius:27px;background:linear-gradient(145deg,#1d9dff,#273d94);box-shadow:0 0 65px #198fff88;border:1px solid #a7e6ff;font-size:45px;font-weight:950}.art-label{position:absolute;bottom:19px;left:20px;color:#b8dfff;font-weight:700}.art-stat{position:absolute;top:18px;right:18px;padding:7px 10px;border-radius:9px;background:#08111ddd;border:1px solid #294a70;color:#8ee2ff;font-size:12px}
.section{padding:25px 0 38px}.section-head{display:flex;justify-content:space-between;gap:20px;align-items:end;margin-bottom:18px}.section h2{font-size:25px;letter-spacing:-.5px;margin:0}.sub{color:var(--muted);margin:4px 0 0}.stats{display:flex;gap:10px;flex-wrap:wrap}.stat{border:1px solid var(--line);background:#0b1422;padding:9px 12px;border-radius:12px;color:var(--muted);font-size:12px}.stat b{color:white;font-size:14px;margin-right:4px}
.filters{display:grid;grid-template-columns:minmax(200px,1fr) 210px 180px;gap:10px;margin:18px 0}.field{display:flex;flex-direction:column;gap:6px}.field label{font-size:12px;color:#b9c9dc;font-weight:700}.control{width:100%;background:#0a1321;color:var(--text);border:1px solid #263d59;border-radius:11px;padding:12px 13px;outline:none}.control:focus{border-color:var(--blue);box-shadow:0 0 0 3px #19a7ff1c}.game-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px}.game-card{min-width:0;display:flex;flex-direction:column;gap:11px;padding:15px;border:1px solid #203650;border-radius:16px;background:linear-gradient(145deg,#0d192a,#09111d);transition:.2s}.game-card:hover{border-color:#318dd1;transform:translateY(-2px);box-shadow:0 12px 28px #0004}.game-top{display:flex;gap:12px;align-items:center}.game-icon{flex:0 0 58px;height:70px;display:grid;place-items:center;border-radius:11px;background:linear-gradient(145deg,#163e64,#1b2852);font-size:28px;border:1px solid #345a7c}.game-icon img{width:100%;height:100%;object-fit:cover;border-radius:10px}.game-name{font-size:15px;line-height:1.2;font-weight:850}.game-meta{color:var(--muted);font-size:11px;margin-top:5px}.tag{display:inline-block;color:#85d8ff;background:#102b42;border:1px solid #214a6b;padding:3px 7px;border-radius:99px;font-size:10px;margin:0 4px 3px 0}.game-card .btn{width:100%;padding:10px;font-size:12px}.empty{grid-column:1/-1;text-align:center;padding:35px;border:1px dashed var(--line);border-radius:14px;color:var(--muted)}
.panel{border:1px solid #203650;border-radius:20px;background:linear-gradient(145deg,#0d192a,#09111d);padding:23px;box-shadow:var(--shadow)}.analyzer-layout{display:grid;grid-template-columns:1fr .9fr;gap:18px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.range-row{display:flex;align-items:center;gap:10px}.range-row input{width:100%;accent-color:var(--blue)}.hint{color:var(--muted);font-size:12px;margin:5px 0 0}.result{background:#091321;border:1px solid #244365;border-radius:15px;padding:18px;min-height:250px}.result h3{margin:0 0 7px}.result-placeholder{color:var(--muted);padding:25px 0}.result ul{padding-left:19px}.result li{margin:7px 0}.meter{height:8px;background:#1a2b40;border-radius:20px;overflow:hidden;margin:12px 0}.meter span{display:block;height:100%;background:linear-gradient(90deg,var(--blue),#68e0ff);width:0;transition:width .4s}.notice{font-size:12px;color:#a8bbd2;border-left:3px solid var(--blue);padding:10px 12px;background:#0b1a2c;border-radius:0 9px 9px 0;margin-top:15px}.tips-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.tip{border:1px solid var(--line);background:#0b1422;border-radius:15px;padding:17px}.tip-icon{font-size:23px}.tip h3{margin:7px 0;font-size:16px}.tip p{margin:0;color:var(--muted);font-size:13px}footer{border-top:1px solid #1c2a40;padding:25px 0 35px;color:var(--muted);font-size:12px}.foot{display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap}.blue{color:#6bd3ff}
@media(max-width:1100px){.game-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.hero{grid-template-columns:1fr .7fr}.nav{gap:14px}.navlinks a{padding:9px 8px}}
@media(max-width:800px){.wrap{padding:0 16px}.nav{height:auto;min-height:66px;flex-wrap:wrap;padding:12px 0;gap:10px}.brand{font-size:22px}.navlinks{order:3;flex-basis:100%;overflow:auto}.navright{margin-left:auto}.hero{grid-template-columns:1fr;padding-top:35px}.hero-art{min-height:220px}.game-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.analyzer-layout{grid-template-columns:1fr}.filters{grid-template-columns:1fr 1fr}.filters .field:first-child{grid-column:1/-1}.tips-grid{grid-template-columns:1fr 1fr}}
@media(max-width:480px){.game-grid{grid-template-columns:1fr}.form-grid{grid-template-columns:1fr}.filters{grid-template-columns:1fr}.filters .field:first-child{grid-column:auto}.section-head{align-items:start;flex-direction:column}.tips-grid{grid-template-columns:1fr}.hero h1{letter-spacing:-1px}}
</style>
